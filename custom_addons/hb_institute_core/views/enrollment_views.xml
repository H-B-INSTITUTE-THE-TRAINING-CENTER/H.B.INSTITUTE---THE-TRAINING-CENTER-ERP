<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =====================================================
         Enrollment List View
         ===================================================== -->

    <record id="view_enrollment_list" model="ir.ui.view">
        <field name="name">enrollment.list</field>
        <field name="model">enrollment</field>
        <field name="arch" type="xml">

            <list string="Enrollments">

                <field name="admission_number"/>
                <field name="admission_date"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="final_fee"/>
                <field name="status"/>

            </list>

        </field>
    </record>


    <!-- =====================================================
         Enrollment Form View
         ===================================================== -->

        <!-- =====================================================
         Enrollment Form View
         ===================================================== -->

    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">enrollment.form</field>
        <field name="model">enrollment</field>
        <field name="arch" type="xml">

            <form string="Enrollment">

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm Admission"
                        type="object"
                        class="oe_highlight"
                        invisible="status != 'draft'"
                    />

                    <button
                        name="action_complete"
                        string="Mark Completed"
                        type="object"
                        class="oe_highlight"
                        invisible="status != 'confirmed'"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="status in ('completed', 'cancelled')"
                    />

                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="status != 'cancelled'"
                    />

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,completed"
                    />

                </header>

                <sheet>

                    <div class="oe_title">

                        <h1>
                            <field name="admission_number"/>
                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="student_id"/>
                            <field name="admission_date"/>

                        </group>

                        <group>

                            <field name="status"/>

                        </group>

                    </group>

                    <group string="Course &amp; Batch">

                        <group>

                            <field name="course_id"/>
                            <field name="batch_id"/>

                        </group>

                    </group>

                    <group string="Fees">

                        <group>

                            <field name="course_fee"/>
                            <field name="discount"/>
                            <field name="final_fee"/>

                        </group>

                    </group>

                    <group string="Notes">

                        <field name="notes"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <!-- =====================================================
         Enrollment Action
         ===================================================== -->

    <record id="action_enrollment" model="ir.actions.act_window">

        <field name="name">Enrollments</field>
        <field name="res_model">enrollment</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- =====================================================
         Enrollment Menu
         ===================================================== -->

    <menuitem
        id="menu_enrollment"
        name="Enrollments"
        parent="menu_hb_institute_root"
        action="action_enrollment"
        sequence="40"/>

</odoo>