<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance List View -->
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">attendance.list</field>
        <field name="model">attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Report"
                decoration-success="status == 'present'"
                decoration-danger="status == 'absent'"
                decoration-warning="status == 'late'"
                decoration-muted="status == 'cancelled'">
                <field name="attendance_date" />
                <field name="batch_id" />
                <field name="student_id" />
                <field name="status" widget="badge" />
                <field name="remarks" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">attendance.form</field>
        <field name="model">attendance</field>
        <field name="arch" type="xml">
            <form string="Student Attendance">
                <sheet>
                    <div class="oe_title">
                        <h1>Student Attendance</h1>
                    </div>

                    <group>
                        <group string="Attendance Details">
                            <field name="student_id" />
                            <field name="batch_id" />
                            <field name="attendance_date" />
                        </group>

                        <group string="Attendance Status">
                            <field name="status" />
                            <field name="remarks" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->

    <record id="view_attendance_search" model="ir.ui.view">
        <field name="name">attendance.search</field>
        <field name="model">attendance</field>
        <field name="arch" type="xml">
            <search string="Attendance Reports">
                <field name="student_id" />
                <field name="batch_id" />
                <field name="attendance_date" />
                <field name="status" />

                <separator />

                <filter name="filter_present"
                    string="Present"
                    domain="[('status', '=', 'present')]" />

                <filter name="filter_absent"
                    string="Absent"
                    domain="[('status', '=', 'absent')]" />

                <filter name="filter_late"
                    string="Late"
                    domain="[('status', '=', 'late')]" />

                <filter name="filter_cancelled"
                    string="Cancelled"
                    domain="[('status', '=', 'cancelled')]" />

                <separator />

                <!-- <filter name="filter_today"
                    string="Today"
                    domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]" /> -->


            </search>
        </field>
    </record>


    <record id="view_attendance_pivot" model="ir.ui.view">
        <field name="name">attendance.pivot</field>
        <field name="model">attendance</field>
        <field name="arch" type="xml">
            <pivot string="Batch-wise Attendance Summary">
                <field name="batch_id" type="row" />
                <field name="status" type="col" />
            </pivot>
        </field>
    </record>


    <record id="view_attendance_graph" model="ir.ui.view">
        <field name="name">attendance.graph</field>
        <field name="model">attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Batch and Status"
                type="bar">
                <field name="batch_id" />
                <field name="status" />
            </graph>
        </field>
    </record>


    <!-- Attendance Window Action -->
    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_attendance_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first attendance record.
            </p>
            <p>
                Record daily student attendance by batch.
            </p>
        </field>
    </record>

    <!-- Attendance Menu -->
    <menuitem
        id="menu_attendance"
        name="Attendance"
        parent="menu_hb_institute_root"
        action="action_attendance"
        sequence="40"
    />


    <!-- Batch-wise Attendance Report Action -->
    <record id="action_attendance_batch_report"
        model="ir.actions.act_window">
        <field name="name">Attendance Report</field>
        <field name="res_model">attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
            ref="view_attendance_search" />
        <field name="context">
            {'search_default_group_by_batch': 1}
        </field>
    </record>

    <!-- Batch-wise Attendance Report Menu -->
    <menuitem
        id="menu_attendance_batch_report"
        name="Attendance Report"
        parent="menu_attendance"
        action="action_attendance_batch_report"
        sequence="10"
    />


</odoo>