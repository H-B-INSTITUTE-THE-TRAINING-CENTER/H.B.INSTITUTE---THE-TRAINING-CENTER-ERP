<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =====================================================
         Student List View
         ===================================================== -->

    <record id="view_student_list" model="ir.ui.view">
        <field name="name">student.list</field>
        <field name="model">student</field>

        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="mobile" />
                <field name="email" />
                <field name="admission_date" />
                <field name="status" />
                <field name="active" />
            </list>
        </field>
    </record>


    <!-- =====================================================
         Student Form View
         ===================================================== -->

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.form</field>
        <field name="model">student</field>

        <field name="arch" type="xml">

            <form string="Student">

                <sheet>

                    <!-- Student Header -->

                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>


                    <!-- Personal Information -->

                    <group string="Personal Information">

                        <group>
                            <field name="date_of_birth" />
                            <field name="gender" />
                        </group>

                        <group>
                            <field name="photo"
                                widget="image"
                                class="oe_avatar" />
                        </group>

                    </group>


                    <!-- Contact Information -->

                    <group string="Contact Information">

                        <group>
                            <field name="mobile" />
                            <field name="alternate_mobile" />
                            <field name="email" />
                        </group>

                        <group>
                            <field name="address" />
                        </group>

                    </group>


                    <!-- Guardian Information -->

                    <group string="Guardian Information">

                        <group>
                            <field name="guardian_name" />
                            <field name="guardian_mobile" />
                        </group>

                        <group>
                            <field name="guardian_relation" />
                        </group>

                    </group>

                    <!-- Admission Information -->

                    <group string="Admission Information">

                        <group>
                            <field name="admission_date" />
                            <field name="status" />
                        </group>

                        <group>
                            <field name="course_id" />
                            <field name="batch_id" />
                            <field name="active" />
                        </group>

                    </group>


                    <!-- Notes -->

                    <group string="Notes">
                        <field name="notes"
                            placeholder="Additional notes about the student..." />
                    </group>
                    <notebook>

                        <page string="Enrollment History">

                            <field name="enrollment_ids">

                                <list editable="bottom">

                                    <field name="admission_number" />
                                    <field name="admission_date" />
                                    <field name="course_id" />
                                    <field name="batch_id" />
                                    <field name="course_fee" />
                                    <field name="discount" />
                                    <field name="final_fee" />
                                    <field name="status" />

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =====================================================
         Student Action
         ===================================================== -->

    <record id="action_student" model="ir.actions.act_window">

        <field name="name">Students</field>

        <field name="res_model">student</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- =====================================================
         Main Menu
         ===================================================== -->

    <menuitem
        id="menu_hb_institute_root"
        name="H.B.INSTITUTE"
        sequence="10"
    />


    <!-- =====================================================
         Student Menu
         ===================================================== -->

    <menuitem
        id="menu_student"
        name="Students"
        parent="menu_hb_institute_root"
        action="action_student"
        sequence="10"
    />

</odoo>