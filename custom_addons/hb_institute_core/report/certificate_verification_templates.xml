<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="certificate_verification_page">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page"
                     style="font-family: Arial, sans-serif;
                            max-width: 800px;
                            margin: 35px auto;
                            padding: 30px;
                            border: 2px solid #20c5a4;
                            color: #26384d;">

                    <div style="text-align: center;">
                        <img
                            src="/hb_institute_core/static/description/hb_logo.png"
                            style="max-width: 110px; max-height: 75px;"/>

                        <h1 style="color: #165780; margin-top: 15px;">
                            Certificate Verification
                        </h1>

                        <p>H.B.INSTITUTE - THE TRAINING CENTER</p>
                    </div>

                    <t t-if="verification_result == 'valid'">
                        <h2 style="color: #16855e;">
                            ✓ Certificate Verified
                        </h2>

                        <p>This certificate is currently valid.</p>

                        <table style="width: 100%;
                                      border-collapse: collapse;">
                            <tr>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    Certificate Number
                                </td>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    <strong t-out="certificate.certificate_number"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    Student
                                </td>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    <strong t-out="certificate.student_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    Course
                                </td>
                                <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    <strong t-out="certificate.course_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 10px;">
                                    Issue Date
                                </td>
                                <td style="padding: 10px;">
                                    <strong t-out="certificate.certificate_date.strftime('%B %d, %Y')"/>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <t t-elif="verification_result == 'revoked'">
                        <h2 style="color: #b42318;">
                            Certificate Revoked
                        </h2>
                        <p>This certificate has been revoked and is not valid.</p>
                        <p>
                            Certificate Number:
                            <strong t-out="certificate.certificate_number"/>
                        </p>
                    </t>

                    <t t-else="">
                        <h2 style="color: #b42318;">
                            Certificate Not Verified
                        </h2>
                        <p>
                            This certificate could not be verified.
                            It may not exist or may not have been issued.
                        </p>
                    </t>

                    <hr style="margin-top: 30px;"/>
                    <p style="text-align: center; color: #667085;">
                        Official certificate verification service
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>